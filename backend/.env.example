# --- Database ---
# `geo_lab` kept for compatibility with existing PostgreSQL data.
# Change to `geoting` for a fresh VDS deployment.
DATABASE_URL=postgresql+psycopg://geo:geo@localhost:5433/geo_lab

# --- RouterAI (single AI gateway for Geoting) ---
# Geoting talks to one OpenAI-compatible API gateway (RouterAI) and passes the
# concrete model (provider/model, e.g. deepseek/deepseek-v4-flash) as a request
# parameter. All Research runs, the semantic analyzer and AI Profiles go
# through this gateway. No provider-specific keys are needed.
# Get a key at https://routerai.ru
ROUTERAI_API_KEY=

# Base URL of the RouterAI OpenAI-compatible API. The default is RouterAI's
# recommended production endpoint; override only if you use a custom gateway.
ROUTERAI_BASE_URL=https://routerai.ru/api/v1

# Model selected by default when creating a new Research (overridable in Settings UI).
# Format: provider/model
ROUTERAI_DEFAULT_MODEL=deepseek/deepseek-v4-flash

# --- Concurrency / retries ---
# Global cap on concurrent outbound AI requests (shared across all researches).
MAX_CONCURRENT_REQUESTS=5
MAX_RETRIES=3
REQUEST_TIMEOUT_SECONDS=120

# --- Analyzer (LLM used for semantic analysis of answers; via RouterAI) ---
ANALYZER_MODEL=deepseek/deepseek-v4-flash

# --- AI Profiles ---
# Runs processed per extraction LLM call; consensus thresholds; min mentions for LLM summary.
PROFILE_EXTRACTION_BATCH_SIZE=5
PROFILE_FREQUENT_THRESHOLD=0.5
PROFILE_MODERATE_THRESHOLD=0.2
PROFILE_SUMMARY_MIN_MENTIONS=3
